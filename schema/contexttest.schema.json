{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/erickdronski/contexttest/main/schema/contexttest.schema.json",
  "title": "ContextTest configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "agent", "variants", "tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "baseRef": { "type": "string", "default": "HEAD" },
    "instructionFile": { "type": "string", "default": "AGENTS.md" },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["codex", "claude", "command", "mock"] },
        "model": { "type": "string" },
        "executable": { "type": "string" },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "timeoutMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "maxTurns": { "type": "integer", "minimum": 1 },
        "permissionMode": { "enum": ["default", "acceptEdits", "plan", "bypassPermissions"] },
        "allowedTools": { "type": "array", "items": { "type": "string" } },
        "disallowedTools": { "type": "array", "items": { "type": "string" } },
        "ignoreUserConfig": { "type": "boolean" }
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": { "type": "integer", "minimum": 1, "maximum": 50, "default": 3 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8, "default": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inherit": { "type": "boolean", "default": false },
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } },
        "set": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "disabled": { "type": "boolean" },
          "source": { "type": "string" },
          "content": { "type": "string" }
        },
        "oneOf": [
          { "required": ["disabled"] },
          { "required": ["source"] },
          { "required": ["content"] }
        ]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "prompt"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "ref": { "type": "string" },
          "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["command", "maxChangedFiles", "minChangedFiles", "maxDiffLines", "allowedPaths", "forbiddenPaths", "requiredFile", "forbiddenFile", "fileContains", "stdoutContains", "stdoutNotContains"] },
        "value": {}, "path": { "type": "string" }, "patterns": { "type": "array", "items": { "type": "string" } },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exitCode": { "type": "integer" }, "timeoutMinutes": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}

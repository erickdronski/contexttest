{
  "name": "@erickdronski/contexttest",
  "version": "0.3.1",
  "description": "A/B testing for AGENTS.md and coding-agent instructions.",
  "type": "module",
  "bin": {
    "contexttest": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "schema",
    "assets/contexttest-mark.svg",
    "assets/report-preview.svg",
    "docs",
    "examples",
    "scripts",
    "test",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm test",
    "smoke:install": "node scripts/smoke-install.mjs",
    "demo": "node src/cli.mjs run --config examples/calculator/contexttest.json",
    "demo:ablate": "node src/cli.mjs ablate --config examples/ablation/contexttest.json",
    "demo:aggregate": "node src/cli.mjs aggregate examples/aggregate/runs/first/report.json examples/aggregate/runs/second/report.json",
    "demo:update": "node scripts/update-demo-output.mjs",
    "doctor": "node src/cli.mjs doctor",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "agents-md",
    "claude-code",
    "codex",
    "coding-agent",
    "evaluation",
    "benchmark",
    "ai"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erickdronski/contexttest.git"
  },
  "bugs": {
    "url": "https://github.com/erickdronski/contexttest/issues"
  },
  "homepage": "https://github.com/erickdronski/contexttest#readme"
}
